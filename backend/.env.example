# Copy file này thành .env và điền giá trị thật.
# TUYỆT ĐỐI không commit file .env — chỉ file .env.example này được push lên git,
# và trong này chỉ được chứa placeholder, không bao giờ là giá trị thật.

PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=caro_token
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT — đổi thành chuỗi ngẫu nhiên dài. Server sẽ không khởi động nếu để trống.
# Tạo: openssl rand -hex 32
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d

# Mã hoá hồ sơ KYC (ảnh CCCD) khi lưu trên đĩa — AES-256-GCM.
# BẮT BUỘC phải có để nộp/xem được hồ sơ KYC.
# Tạo: openssl rand -hex 32   (đúng 64 ký tự hex)
# ⚠️ Mất khoá này = mất toàn bộ hồ sơ KYC đã lưu. Sao lưu ở nơi an toàn, ngoài git.
KYC_ENCRYPTION_KEY=your_64_hex_char_key_here

# OCR CCCD (FPT.AI Vision). Không có thì tính năng OCR trả về 503.
# Lấy tại: https://fpt.ai/
OCR_API_KEY=YOUR_FPT_AI_API_KEY

# CORS — danh sách origin được phép, phân tách bằng dấu phẩy.
# Để trống khi dev local sẽ mặc định cho phép http://localhost:5173 và :3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limit (tuỳ chọn)
RATE_LIMIT_MAX=1000
RATE_LIMIT_LOGIN_MAX=10

# Blockchain (tùy chọn — bỏ trống để chạy off-chain mode)
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MINTER_PRIVATE_KEY=0xYOUR_WALLET_PRIVATE_KEY
CA_RO_CR1=0xCONTRACT_ADDRESS_CR1
CA_RO_CR2=0xCONTRACT_ADDRESS_CR2
CA_RO_CR3=0xCONTRACT_ADDRESS_CR3

# Internal Exchange — địa chỉ ví treasury của platform (nhận token khi mint on-chain)
# Bỏ trống → bỏ qua blockchain, chỉ cập nhật số dư nội bộ (off-chain mode)
PLATFORM_TREASURY_ADDRESS=0xYOUR_PLATFORM_TREASURY_ADDRESS

# Infura IPFS (tùy chọn — bỏ trống để lưu file local, không upload IPFS)
# Lấy tại: https://app.infura.io → Create New Key → IPFS
INFURA_IPFS_PROJECT_ID=YOUR_INFURA_IPFS_PROJECT_ID
INFURA_IPFS_SECRET=YOUR_INFURA_IPFS_SECRET

# Market mode: MOCK = generated data (default), LIVE = real blockchain market
MARKET_MODE=MOCK

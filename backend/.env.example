# Copy file này thành .env và điền giá trị thật

PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=caro_token
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT — đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET=your_super_secret_key_here

# Blockchain (tùy chọn — bỏ trống để chạy off-chain mode)
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MINTER_PRIVATE_KEY=0xYOUR_WALLET_PRIVATE_KEY
CA_RO_CR1=0xCONTRACT_ADDRESS_CR1
CA_RO_CR2=0xCONTRACT_ADDRESS_CR2
CA_RO_CR3=0xCONTRACT_ADDRESS_CR3

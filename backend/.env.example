# Copy file này thành .env và điền giá trị thật

PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=caro_token
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT — đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET=your_super_secret_key_here

# Blockchain (tùy chọn — bỏ trống để chạy off-chain mode)
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MINTER_PRIVATE_KEY=0xYOUR_WALLET_PRIVATE_KEY
CA_RO_CR1=0xCONTRACT_ADDRESS_CR1
CA_RO_CR2=0xCONTRACT_ADDRESS_CR2
CA_RO_CR3=0xCONTRACT_ADDRESS_CR3

# Internal Exchange — địa chỉ ví treasury của platform (nhận token khi mint on-chain)
# Bỏ trống → bỏ qua blockchain, chỉ cập nhật số dư nội bộ (off-chain mode)
PLATFORM_TREASURY_ADDRESS=0xYOUR_PLATFORM_TREASURY_ADDRESS

# Infura IPFS (tùy chọn — bỏ trống để lưu file local, không upload IPFS)
# Lấy tại: https://app.infura.io → Create New Key → IPFS
INFURA_IPFS_PROJECT_ID=YOUR_INFURA_IPFS_PROJECT_ID
INFURA_IPFS_SECRET=***REMOVED-INFURA-SECRET***